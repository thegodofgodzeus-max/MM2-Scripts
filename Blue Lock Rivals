local function AntiAFK()
    if not Settings.AntiAFK then return end
    
    spawn(function()
        while wait(25) do
            if Settings.AntiAFK then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid:Jump()
                    wait(0.05)
                    char.Humanoid:Jump()
                end
            end
        end
    end)
end

