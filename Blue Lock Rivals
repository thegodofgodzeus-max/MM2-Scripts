spawn(function()
    while wait(0.2) do
        pcall(function()
            CreateESP()
            if Settings.AutoFarm then AutoFarm() end
            if Settings.AutoSteal then AutoSteal() end
            MovementHacks()
            if flyEnabled and Settings.Fly then UpdateFly() end
        end)
    end
end)

AntiAFK()

