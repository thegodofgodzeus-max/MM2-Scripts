local function ClearESP()
    for _, data in pairs(ESPObjects) do
        if data then pcall(function() data:Destroy() end) end
    end
    ESPObjects = {}
end

local function CreateESP()
    if not Settings.ESP then
        ClearESP()
        return
    end

    -- Top ESP
    if Settings.BallESP then
        local ball = FindBall()
        if ball and not ESPObjects["Ball"] then
            local bill = Instance.new("BillboardGui")
            bill.Size = UDim2.new(0, 120, 0, 50)
            bill.StudsOffset = Vector3.new(0, 2, 0)
            bill.AlwaysOnTop = true
            bill.Adornee = ball
            bill.Parent = ball
            
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundTransparency = 0.2
            frame.BackgroundColor3 = Color3.new(1, 0.8, 0)
            frame.BorderSizePixel = 2
            frame.BorderColor3 = Color3.new(1, 1, 1)
            frame.Parent = bill
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "⚽ TOP"
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold
            label.Parent = frame
            
            ESPObjects["Ball"] = bill
        end
    end

    -- Oyuncu ESP
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
            if ESPObjects[player] then
                pcall(function() ESPObjects[player]:Destroy() end)
                ESPObjects[player] = nil
            end
            continue
        end
        
        if not ESPObjects[player] then
            local color = player.TeamColor and player.TeamColor.Color or Color3.new(1, 0, 0)
            
            local bill = Instance.new("BillboardGui")
            bill.Size = UDim2.new(0, 200, 0, 80)
            bill.StudsOffset = Vector3.new(0, 3.5, 0)
            bill.AlwaysOnTop = true
            bill.Adornee = char
            bill.Parent = char
            
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundTransparency = Settings.BoxESP and 0.2 or 1
            frame.BackgroundColor3 = color
            frame.BorderSizePixel = Settings.BoxESP and 3 or 0
            frame.BorderColor3 = Color3.new(1, 1, 1)
            frame.Parent = bill
            
            -- İsim
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 0.35, 0)
            nameLabel.Position = UDim2.new(0, 0, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = Settings.NameESP and player.Name or ""
            nameLabel.TextColor3 = Color3.new(1, 1, 1)
            nameLabel.TextScaled = true
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.Parent = frame
            
            -- Takım
            local teamLabel = Instance.new("TextLabel")
            teamLabel.Size = UDim2.new(1, 0, 0.3, 0)
            teamLabel.Position = UDim2.new(0, 0, 0.35, 0)
            teamLabel.BackgroundTransparency = 1
            teamLabel.Text = player.Team and player.Team.Name or "Takım Yok"
            teamLabel.TextColor3 = Color3.new(0.8, 0.8, 0.8)
            teamLabel.TextScaled = true
            teamLabel.Font = Enum.Font.Gotham
            teamLabel.Parent = frame
            
            -- Mesafe
            local distLabel = Instance.new("TextLabel")
            distLabel.Size = UDim2.new(1, 0, 0.3, 0)
            distLabel.Position = UDim2.new(0, 0, 0.65, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.Text = "0m"
            distLabel.TextColor3 = Color3.new(0.8, 0.8, 0.8)
            distLabel.TextScaled = true
            distLabel.Font = Enum.Font.Gotham
            distLabel.Parent = frame
            
            ESPObjects[player] = bill
        end
        
        -- Güncellemeler
        if ESPObjects[player] and ESPObjects[player]:FindFirstChild("Frame") then
            local frame = ESPObjects[player].Frame
            local localChar = LocalPlayer.Character
            
            if frame and frame:FindFirstChild("DistLabel") and localChar and localChar:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - localChar.HumanoidRootPart.Position).Magnitude
                frame.DistLabel.Text = Settings.DistanceESP and string.format("%.1fm", dist) or ""
            end
            
            if Settings.RainbowESP then
                frame.BackgroundColor3 = Color3.fromHSV(tick() % 1, 1, 1)
            end
        end
    end
end

-- ================================================
-- OTOMATİK FARM
-- ================================================

local function AutoFarm()
    if not Settings.AutoFarm then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local ball = FindBall()
    if ball then
        local dist = (ball.Position - hrp.Position).Magnitude
        if dist < 20 then
            -- Tope doğru koş
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                humanoid:MoveTo(ball.Position)
            end
        end
    end
end

-- ================================================
-- OTOMATİK TOP ÇALMA
-- ================================================

local function AutoSteal()
    if not Settings.AutoSteal then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local target, dist = GetClosestPlayer(true)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and dist < 10 then
        -- Top çalma işlemi
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:MoveTo(target.Character.HumanoidRootPart.Position)
        end
    end
end

-- ================================================
-- AIMBOT
-- ================================================

local function UpdateAimbot()
    if not Settings.Aimbot then return end
    
    local target, dist = GetClosestPlayer(true)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
    if dist > Settings.AimbotRange then return end
    
    local targetPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 1.5, 0)
    local currentCF = Camera.CFrame
    local lookAt = CFrame.lookAt(currentCF.Position, targetPos)
    
    if Settings.AimbotSmoothness > 0 then
        local smooth = Settings.AimbotSmoothness / 10
        Camera.CFrame = currentCF:Lerp(lookAt, smooth)
    else
        Camera.CFrame = lookAt
    end
end

