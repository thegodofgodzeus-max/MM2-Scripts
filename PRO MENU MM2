local function CreateESP()
    if not Settings.ESP then
        ClearESP()
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
            if ESPObjects[player] then
                pcall(function() ESPObjects[player]:Destroy() end)
                ESPObjects[player] = nil
            end
            continue
        end
        
        if not ESPObjects[player] then
            local color = player.TeamColor and player.TeamColor.Color or Color3.new(1, 0, 0)
            
            local bill = Instance.new("BillboardGui")
            bill.Size = UDim2.new(0, 200, 0, 90) -- Biraz büyüttüm rol için
            bill.StudsOffset = Vector3.new(0, 3, 0)
            bill.AlwaysOnTop = true
            bill.Adornee = char
            bill.Parent = char
            
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundTransparency = Settings.Boxes and 0.2 or 1
            frame.BackgroundColor3 = color
            frame.BorderSizePixel = Settings.Boxes and 2 or 0
            frame.BorderColor3 = Color3.new(1, 1, 1)
            frame.Parent = bill
            
            -- İsim (Names)
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 0.3, 0)
            nameLabel.Position = UDim2.new(0, 0, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = Settings.Names and player.Name or ""
            nameLabel.TextColor3 = Color3.new(1, 1, 1)
            nameLabel.TextScaled = true
            nameLabel.Font = Enum.Font.SourceSansBold
            nameLabel.Parent = frame
            
            -- ROL ETİKETİ (🔪 KATİL / 🔫 ŞERİF / 👤 MASUM)
            local roleLabel = Instance.new("TextLabel")
            roleLabel.Size = UDim2.new(1, 0, 0.35, 0)
            roleLabel.Position = UDim2.new(0, 0, 0.3, 0)
            roleLabel.BackgroundTransparency = 1
            roleLabel.Text = "???"
            roleLabel.TextColor3 = Color3.new(1, 0.8, 0)
            roleLabel.TextScaled = true
            roleLabel.Font = Enum.Font.GothamBold
            roleLabel.Parent = frame
            
            -- Mesafe (Distance)
            local distLabel = Instance.new("TextLabel")
            distLabel.Size = UDim2.new(1, 0, 0.3, 0)
            distLabel.Position = UDim2.new(0, 0, 0.65, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.Text = "0m"
            distLabel.TextColor3 = Color3.new(0.8, 0.8, 0.8)
            distLabel.TextScaled = true
            distLabel.Font = Enum.Font.SourceSans
            distLabel.Parent = frame
            
            ESPObjects[player] = bill
        end
        
        -- Güncellemeler
        if ESPObjects[player] and ESPObjects[player]:FindFirstChild("Frame") then
            local frame = ESPObjects[player].Frame
            local localChar = LocalPlayer.Character
            
            -- Mesafe güncelle
            if frame and frame:FindFirstChild("DistLabel") and localChar and localChar:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - localChar.HumanoidRootPart.Position).Magnitude
                frame.DistLabel.Text = Settings.Distance and string.format("%.1fm", dist) or ""
            end
            
            -- ROL KONTROLÜ (Katil / Şerif / Masum)
            if frame and frame:FindFirstChild("RoleLabel") then
                local roleText = "👤 Masum"
                local roleColor = Color3.new(0.3, 0.8, 0.3) -- Yeşil
                local isMurderer = false
                local isSheriff = false
                
                -- Backpack'teki araçları kontrol et
                local backpack = char:FindFirstChild("Backpack")
                if backpack then
                    for _, tool in pairs(backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            local toolName = tool.Name:lower()
                            if toolName:find("knife") or toolName:find("blade") then
                                isMurderer = true
                                break
                            elseif toolName:find("gun") or toolName:find("pistol") then
                                isSheriff = true
                                break
                            end
                        end
                    end
                end
                
                -- Elindeki araçları da kontrol et
                if not isMurderer and not isSheriff then
                    for _, tool in pairs(char:GetChildren()) do
                        if tool:IsA("Tool") then
                            local toolName = tool.Name:lower()
                            if toolName:find("knife") or toolName:find("blade") then
                                isMurderer = true
                                break
                            elseif toolName:find("gun") or toolName:find("pistol") then
                                isSheriff = true
                                break
                            end
                        end
                    end
                end
                
                -- Rol etiketini ayarla
                if isMurderer then
                    roleText = "🔪 KATİL"
                    roleColor = Color3.new(1, 0, 0) -- Kırmızı
                    frame.BackgroundColor3 = Color3.new(1, 0, 0)
                elseif isSheriff then
                    roleText = "🔫 ŞERİF"
                    roleColor = Color3.new(0.2, 0.6, 1) -- Mavi
                    frame.BackgroundColor3 = Color3.new(0.2, 0.4, 0.8)
                else
                    roleText = "👤 Masum"
                    roleColor = Color3.new(0.3, 0.8, 0.3) -- Yeşil
                    frame.BackgroundColor3 = Color3.new(0, 0.5, 0)
                end
                
                frame.RoleLabel.Text = roleText
                frame.RoleLabel.TextColor3 = roleColor
            end
            
            -- Rainbow
            if Settings.Rainbow then
                frame.BackgroundColor3 = Color3.fromHSV(tick() % 1, 1, 1)
            end
            
            -- Wallhack
            if Settings.Wallhack then
                ESPObjects[player].AlwaysOnTop = true
            end
        end
    end
end
