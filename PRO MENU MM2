-- ================================================
-- ROL KONTROLÜ
-- ================================================

local function GetMyRole()
    local char = LocalPlayer.Character
    if not char then return "Innocent" end
    
    local backpack = char:FindFirstChild("Backpack")
    if not backpack then return "Innocent" end
    
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.Name:lower():find("knife") or tool.Name:lower():find("blade") then
                return "Murderer"
            elseif tool.Name:lower():find("gun") or tool.Name:lower():find("pistol") then
                return "Sheriff"
            end
        end
    end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.Name:lower():find("knife") or tool.Name:lower():find("blade") then
                return "Murderer"
            elseif tool.Name:lower():find("gun") or tool.Name:lower():find("pistol") then
                return "Sheriff"
            end
        end
    end
    
    return "Innocent"
end

-- ================================================
-- EN YAKIN OYUNCUYU BUL
-- ================================================

local function GetClosestPlayer(ignoreTeam)
    local closest = nil
    local shortest = math.huge
    local localChar = LocalPlayer.Character
    if not localChar then return nil end
    local hrp = localChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                if ignoreTeam and LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
                    continue
                end
                local dist = (char.HumanoidRootPart.Position - hrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = player
                end
            end
        end
    end
    
    return closest, shortest
end

-- ================================================
-- ESP SİSTEMİ (Görseldeki gibi)
-- ================================================

local function ClearESP()
    for _, data in pairs(ESPObjects) do
        if data then pcall(function() data:Destroy() end) end
    end
    ESPObjects = {}
end

local function CreateESP()
    if not Settings.ESP then
        ClearESP()
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
            if ESPObjects[player] then
                pcall(function() ESPObjects[player]:Destroy() end)
                ESPObjects[player] = nil
            end
            continue
        end
        
        if not ESPObjects[player] then
            local color = player.TeamColor and player.TeamColor.Color or Color3.new(1, 0, 0)
            
            -- Ana Billboard
            local bill = Instance.new("BillboardGui")
            bill.Size = UDim2.new(0, 200, 0, 70)
            bill.StudsOffset = Vector3.new(0, 3, 0)
            bill.AlwaysOnTop = true
            bill.Adornee = char
            bill.Parent = char
            
            -- Kutu (Boxes)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundTransparency = Settings.Boxes and 0.2 or 1
            frame.BackgroundColor3 = color
            frame.BorderSizePixel = Settings.Boxes and 2 or 0
            frame.BorderColor3 = Color3.new(1, 1, 1)
            frame.Parent = bill
            
            -- İsim (Names)
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 0.35, 0)
            nameLabel.Position = UDim2.new(0, 0, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = Settings.Names and player.Name or ""
            nameLabel.TextColor3 = Color3.new(1, 1, 1)
            nameLabel.TextScaled = true
            nameLabel.Font = Enum.Font.SourceSansBold
            nameLabel.Parent = frame
            
            -- Mesafe (Distance)
            local distLabel = Instance.new("TextLabel")
            distLabel.Size = UDim2.new(1, 0, 0.3, 0)
            distLabel.Position = UDim2.new(0, 0, 0.35, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.Text = "0m"
            distLabel.TextColor3 = Color3.new(0.8, 0.8, 0.8)
            distLabel.TextScaled = true
            distLabel.Font = Enum.Font.SourceSans
            distLabel.Parent = frame
            
            -- Rol (Players/Team)
            local roleLabel = Instance.new("TextLabel")
            roleLabel.Size = UDim2.new(1, 0, 0.35, 0)
            roleLabel.Position = UDim2.new(0, 0, 0.65, 0)
            roleLabel.BackgroundTransparency = 1
            roleLabel.Text = "👤"
            roleLabel.TextColor3 = Color3.new(0.8, 0.8, 0.8)
            roleLabel.TextScaled = true
            roleLabel.Font = Enum.Font.SourceSans
            roleLabel.Parent = frame
            
            -- Skeleton (İskelet) - Basit gösterim
            if Settings.Skeleton then
                -- Basit bir çizgi gösterimi (oyuncunun duruşunu simüle eder)
                local skeletonFrame = Instance.new("Frame")
                skeletonFrame.Size = UDim2.new(0, 2, 0.5, 0)
                skeletonFrame.Position = UDim2.new(0.5, -1, 0.5, 0)
                skeletonFrame.BackgroundColor3 = Color3.new(1, 1, 1)
                skeletonFrame.BackgroundTransparency = 0.3
                skeletonFrame.Parent = bill
            end
            
            ESPObjects[player] = bill
        end
        
        -- Güncellemeler
        if ESPObjects[player] and ESPObjects[player]:FindFirstChild("Frame") then
            local frame = ESPObjects[player].Frame
            local localChar = LocalPlayer.Character
            
            -- Mesafe güncelle
            if frame and frame:FindFirstChild("DistLabel") and localChar and localChar:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - localChar.HumanoidRootPart.Position).Magnitude
                frame.DistLabel.Text = Settings.Distance and string.format("%.1fm", dist) or ""
            end
            
            -- Rol güncelle
            if frame and frame:FindFirstChild("RoleLabel") then
                local isMurderer = false
                local backpack = char:FindFirstChild("Backpack")
                if backpack then
                    for _, tool in pairs(backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("knife") or tool.Name:lower():find("blade")) then
                            isMurderer = true
                            break
                        end
                    end
                end
                frame.RoleLabel.Text = isMurderer and "🔪" or "👤"
                frame.BackgroundColor3 = isMurderer and Color3.new(1, 0, 0) or Color3.new(0, 0.5, 0)
            end
            
            -- Rainbow
            if Settings.Rainbow then
                frame.BackgroundColor3 = Color3.fromHSV(tick() % 1, 1, 1)
            end
            
            -- Wallhack (Duvarlardan görme)
            if Settings.Wallhack then
                ESPObjects[player].AlwaysOnTop = true
            end
        end
    end
end

-- ================================================
-- AIMBOT (Görseldeki gibi)
-- ================================================

local function UpdateAimbot()
    if not Settings.Aimbot then return end
    
    local target, dist = GetClosestPlayer(true)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
    if dist > Settings.AimbotRange then return end
    
    local targetPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 1.5, 0)
    local currentCF = Camera.CFrame
    local lookAt = CFrame.lookAt(currentCF.Position, targetPos)
    
    if Settings.AimbotSmoothness > 0 then
        local smooth = Settings.AimbotSmoothness / 10
        Camera.CFrame = currentCF:Lerp(lookAt, smooth)
    else
        Camera.CFrame = lookAt
    end
end

-- ================================================
-- RANGE ESP (Menzil Göstergesi)
-- ================================================

local function CreateRangeESP()
    if not Settings.RangeESP then
        -- Mevcut range ESP'leri temizle
        return
    end
    
    -- Range ESP: Oyuncunun etrafında daire gösterir
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Basit bir daire gösterimi (part ile)
    local rangePart = Instance.new("Part")
    rangePart.Size = Vector3.new(Settings.AimbotRange * 2, 0.1, Settings.AimbotRange * 2)
    rangePart.Position = hrp.Position
    rangePart.Anchored = true
    rangePart.CanCollide = false
    rangePart.Transparency = 0.8
    rangePart.BrickColor = BrickColor.new("Bright red")
    rangePart.Parent = workspace
    
    -- Güncelleme döngüsü
    spawn(function()
        while Settings.RangeESP and rangePart and rangePart.Parent do
            if hrp and hrp.Parent then
                rangePart.Position = hrp.Position
            end
            wait(0.1)
        end
        if rangePart then rangePart:Destroy() end
    end)
end

-- ================================================
-- SHOOTING (Otomatik Ateş Etme)
-- ================================================

local function AutoShoot()
    if not Settings.Shooting then return end
    
    local role = GetMyRole()
    if role ~= "Sheriff" then return end
    
    local target, dist = GetClosestPlayer(true)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
    if dist > 50 then return end
    
    local localChar = LocalPlayer.Character
    if not localChar then return end
    
    local weapon = localChar:FindFirstChildOfClass("Tool")
    if not weapon or not weapon.Name:lower():find("gun") then return end
    
    local shootEvent = game:GetService("ReplicatedStorage"):FindFirstChild("ShootEvent")
    if shootEvent then
        shootEvent:FireServer(target.Character)
    end
end

-- ================================================
-- ANA DÖNGÜ
-- ================================================

spawn(function()
    while wait(0.1) do
        pcall(function()
            CreateESP()
            if Settings.Aimbot then UpdateAimbot() end
            if Settings.Shooting then AutoShoot() end
            if Settings.RangeESP then CreateRangeESP() end
        end)
    end
end)

